# Copy this file to .env, replace the placeholders, then load it before starting:
#   cp .env.example .env
#   set -a; source .env; set +a
#   npm run start

# Required by the service. Generate with: openssl rand -hex 24
AZEWEB_ACCESS_TOKEN="replace-with-a-random-48-character-token"

# Command Code Provider API key from https://commandcode.ai/studio
AZEWEB_AUTHORING_API_KEY="replace-with-your-command-code-api-key"

# These defaults target Command Code's OpenAI-compatible Responses API.
AZEWEB_AUTHORING_BASE_URL="https://api.commandcode.ai/provider/v1"
AZEWEB_AUTHORING_MODEL="deepseek/deepseek-v4-flash"
