{
  "name": "aze-forge-web",
  "version": "0.1.0",
  "private": true,
  "description": "AzeForge Web: ephemeral Node compiler service plus edit-preview-export frontend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "scripts": {
    "start": "node src/service/main.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:service": "node --test test/service-http.test.mjs test/walkthrough-http.test.mjs",
    "test:compiler": "node --test test/compiler-integration.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "walkthrough": "node scripts/walkthrough.mjs",
    "workspace": "node scripts/workspace.mjs",
    "cutover": "node scripts/cutover.mjs",
    "build:public": "node scripts/public-site.mjs",
    "preview:public": "npm run build:public && python3 -m http.server --directory public 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aruzone/aze-forge": "0.6.4",
    "openai": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "5.9.2"
  }
}
